{
  "name": "@dentos/web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "predev": "pnpm run pdf-worker && pnpm run stock-wasm",
    "dev": "next dev",
    "prebuild": "pnpm run pdf-worker && pnpm run stock-wasm",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "pdf-worker": "node -e \"const p=require('path');require('fs').copyFileSync(p.join(p.dirname(require.resolve('pdfjs-dist/package.json')),'legacy','build','pdf.worker.min.mjs'),'public/pdf.worker.min.mjs')\"",
    "stock-wasm": "node -e \"const f=require('fs'),p=require('path');const v=require('zxing-wasm/reader').ZXING_WASM_VERSION;const d='public/vendor';const n='zxing-reader-'+v+'.wasm';f.mkdirSync(d,{recursive:true});for(const x of f.readdirSync(d))if(/^zxing-reader-.*\\.wasm$/.test(x)&&x!==n)f.unlinkSync(p.join(d,x));f.copyFileSync(require.resolve('zxing-wasm/reader/zxing_reader.wasm'),p.join(d,n))\""
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@supabase/ssr": "^0.0.10",
    "@supabase/supabase-js": "^2.38.0",
    "axios": "^1.6.0",
    "next": "^14.0.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^4.4.0",
    "zxing-wasm": "3.1.3"
  },
  "devDependencies": {
    "@testing-library/react": "^14.1.2",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.54.0",
    "eslint-config-next": "^14.0.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.3",
    "vitest": "^1.0.4"
  }
}
